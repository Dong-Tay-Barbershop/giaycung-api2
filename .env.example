# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/giaycung

# Auth
JWT_SECRET=your-secret-key-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# CORS (comma-separated, optional — defaults to giaycung.vn + localhost)
ALLOWED_ORIGINS=https://giaycung.vn,https://www.giaycung.vn,http://localhost:5173

# VietQR callback: VietQR -> GiayCung
VIETQR_CALLBACK_USERNAME=
VIETQR_CALLBACK_PASSWORD=
VIETQR_CALLBACK_JWT_SECRET=

# VietQR API: GiayCung -> VietQR
VIETQR_ENV=sandbox
VIETQR_API_BASE_URL=https://dev.vietqr.org
VIETQR_API_USERNAME=
VIETQR_API_PASSWORD=

# VietQR merchant account
VIETQR_BANK_CODE=
VIETQR_BANK_ACCOUNT=
VIETQR_BANK_ACCOUNT_NAME=
VIETQR_TERMINAL_CODE=
VIETQR_RETURN_URL=
