# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/giaycung

# Auth
JWT_SECRET=your-secret-key-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# CORS (comma-separated, optional — defaults to giaycung.vn + localhost)
ALLOWED_ORIGINS=https://giaycung.vn,https://www.giaycung.vn,http://localhost:5173
